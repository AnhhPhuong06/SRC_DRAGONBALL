# Copy to alyra.properties; set DB password and public VPS address before running.
server.local=false
server.test=false
server.daoautoupdater=true
server.onlyadmin=false
server.sv=1
server.name=DragonBall
server.ip=127.0.0.1
server.port=14446
server.sv1=DragonBall:127.0.0.1:14446
server.waitlogin=5
server.maxperip=10
server.maxplayer=100
server.expserver=1
server.debug=0
server.blackball.timewin_second=300
database.driver=org.mariadb.jdbc.Driver
database.host=127.0.0.1
database.port=3306
database.name=supervip_acc
database.name_data=supervip_data
